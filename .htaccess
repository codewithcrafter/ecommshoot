# ECOMSHOOT - Production Apache URL Routing Configuration
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 0. Canonical Production Redirection: Enforce WWW for apex domain
RewriteCond %{HTTP_HOST} ^ecomshoots\.in$ [NC]
RewriteRule ^(.*)$ https://www.ecomshoots.in/$1 [R=301,L]

RewriteCond %{HTTP_HOST} ^www\.ecomshoots\.in$ [NC]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://www.ecomshoots.in/$1 [R=301,L]

# Canonical public URLs: redirect legacy .php requests before file checks.
RewriteCond %{THE_REQUEST} \s/+index\.php[?\s] [NC]
RewriteRule ^index\.php$ / [R=301,L]

# Canonical redirect for discontinued enterprise service
RewriteRule ^(?:services?/)?professional-product-photography(\.php)?$ /service/product-photography [R=301,L]

# 1. Services Catalog: /services or /services/ -> services.php
# (Must precede physical directory check because 'services' is a physical folder on disk)
RewriteRule ^services/?$ services.php [QSA,L,NC]

# 2. Service Detail Pages: /service/{slug} and /services/{slug}
RewriteRule ^service/([a-z0-9-]+)/?$ $1.php [QSA,L,NC]
RewriteRule ^services/([a-z0-9-]+)/?$ $1.php [QSA,L,NC]

# 3. Universal Markdown Document Endpoints (.md)
# Direct access to .md opens raw markdown inline (never 404 or redirect)
RewriteRule ^(pages|services|service|resources|business|blog)/([a-z0-9-]+)\.md$ markdown-serve.php?path=$1/$2 [QSA,L,NC]
RewriteRule ^([a-z0-9-]+)\.md$ markdown-serve.php?path=$1 [QSA,L,NC]

# 4. Blog HTML by Slug: /blog/article-slug -> blog-detail.php?slug=article-slug
RewriteRule ^blog/([a-z0-9-]+)/?$ blog-detail.php?slug=$1 [QSA,L,NC]

# 5. Blog Root: /blog or /blog/ -> blog.php
RewriteRule ^blog/?$ blog.php [QSA,L,NC]

# 6. Do not rewrite existing physical files or directories (except /services which is handled above)
RewriteCond %{REQUEST_URI} !^/services/?$ [NC]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 7. Extensionless public routes, including form endpoints while preserving requests.
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [QSA,L]

# 8. Prevent direct browser access to /content/ directory files
RewriteRule ^content/ - [F,L]

</IfModule>

# Custom Error Documents
ErrorDocument 404 /

# Security & Character Encoding Defaults
AddDefaultCharset UTF-8
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
